<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VELOURA | Bespoke Hair Artistry & Studio</title>
    <!-- Google Fonts for a Classy Editorial Look -->
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <style>
        /* --- CSS VARIABLES & THEME --- */
        :root {
            --bg-cream: #FAF8F5;
            --bg-sand: #F2EDE4;
            --text-dark: #1E1C1A;
            --text-muted: #6B655E;
            --gold-accent: #C5A059;
            --gold-hover: #B08D48;
            --white: #FFFFFF;
            --font-serif: 'Cormorant Garamond', Georgia, serif;
            --font-sans: 'Montserrat', sans-serif;
            --transition: all 0.3s ease;
        }

        /* --- RESET & BASE STYLES --- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-cream);
            color: var(--text-dark);
            font-family: var(--font-sans);
            line-height: 1.6;
            overflow-x: hidden;
        }

        h1, h2, h3, .brand-logo {
            font-family: var(--font-serif);
            font-weight: 600;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* --- NAVIGATION --- */
        header {
            position: fixed;
            top: 0;
            width: 100%;
            background: rgba(250, 248, 245, 0.95);
            backdrop-filter: blur(10px);
            padding: 1.2rem 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
            border-bottom: 1px solid rgba(197, 160, 89, 0.2);
        }

        .brand-logo {
            font-size: 1.8rem;
            letter-spacing: 3px;
            color: var(--text-dark);
        }

        .brand-logo span {
            color: var(--gold-accent);
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 2rem;
            align-items: center;
        }

        nav a {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-weight: 500;
            transition: var(--transition);
        }

        nav a:hover {
            color: var(--gold-accent);
        }

        .btn-nav {
            background-color: var(--text-dark);
            color: var(--white) !important;
            padding: 0.7rem 1.5rem;
            border-radius: 2px;
        }

        .btn-nav:hover {
            background-color: var(--gold-accent);
        }

        /* --- HERO SECTION --- */
        .hero {
            min-height: 95vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 8rem 5% 4rem;
            background: linear-gradient(rgba(30, 28, 26, 0.55), rgba(30, 28, 26, 0.65)), 
                        url('https://unsplash.com') center/cover no-repeat;
            color: var(--white);
        }

        .hero-content {
            max-width: 750px;
        }

        .hero-subtitle {
            text-transform: uppercase;
            letter-spacing: 4px;
            font-size: 0.85rem;
            color: var(--gold-accent);
            margin-bottom: 1rem;
            display: block;
            font-weight: 500;
        }

        .hero h1 {
            font-size: clamp(2.8rem, 6vw, 4.8rem);
            line-height: 1.1;
            margin-bottom: 1.5rem;
            font-weight: 500;
        }

        .hero h1 em {
            font-style: italic;
            color: #F3E5C8;
        }

        .hero p {
            font-size: 1.05rem;
            font-weight: 300;
            margin-bottom: 2.5rem;
            color: #EAE6DF;
        }

        .btn-primary {
            display: inline-block;
            background-color: var(--gold-accent);
            color: var(--white);
            padding: 1rem 2.5rem;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 500;
            border: none;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-primary:hover {
            background-color: var(--gold-hover);
            transform: translateY(-2px);
        }

        /* --- SECTIONS COMMON --- */
        section {
            padding: 6rem 8%;
        }

        .section-header {
            text-align: center;
            max-width: 600px;
            margin: 0 auto 4rem;
        }

        .section-header span {
            color: var(--gold-accent);
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .section-header h2 {
            font-size: 2.8rem;
            margin-top: 0.5rem;
            color: var(--text-dark);
        }

        /* --- SERVICES MENU --- */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
        }

        .service-card {
            background: var(--white);
            padding: 2.5rem 2rem;
            border: 1px solid rgba(197, 160, 89, 0.25);
            transition: var(--transition);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .service-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.05);
            border-color: var(--gold-accent);
        }

        .service-top {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            border-bottom: 1px dashed #E2DCD3;
            padding-bottom: 1rem;
            margin-bottom: 1rem;
        }

        .service-top h3 {
            font-size: 1.5rem;
        }

        .price {
            font-weight: 600;
            color: var(--gold-accent);
            font-size: 1.1rem;
        }

        .service-card p {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 1.5rem;
        }

        .duration {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-dark);
            font-weight: 500;
        }

        /* --- BOOKING SECTION --- */
        .booking-section {
            background-color: var(--bg-sand);
        }

        .booking-container {
            max-width: 850px;
            margin: 0 auto;
            background: var(--white);
            padding: 3.5rem;
            box-shadow: 0 20px 50px rgba(30, 28, 26, 0.06);
            border-top: 4px solid var(--gold-accent);
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        label {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            margin-bottom: 0.5rem;
            font-weight: 600;
            color: var(--text-dark);
        }

        input, select, textarea {
            padding: 0.9rem 1rem;
            border: 1px solid #DCD6CD;
            background-color: var(--bg-cream);
            font-family: var(--font-sans);
            font-size: 0.95rem;
            color: var(--text-dark);
            outline: none;
            transition: var(--transition);
        }

        input:focus, select:focus, textarea:focus {
            border-color: var(--gold-accent);
            background-color: var(--white);
        }

        /* Time Slot Pills */
        .time-slots {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
            gap: 0.8rem;
            margin-top: 0.3rem;
        }

        .time-slot {
            padding: 0.7rem;
            text-align: center;
            border: 1px solid #DCD6CD;
            background: var(--bg-cream);
            cursor: pointer;
            font-size: 0.85rem;
            font-weight: 500;
            transition: var(--transition);
        }

        .time-slot:hover {
            border-color: var(--gold-accent);
        }

        .time-slot.selected {
            background-color: var(--text-dark);
            color: var(--white);
            border-color: var(--text-dark);
        }

        .submit-btn {
            width: 100%;
            margin-top: 1.5rem;
            padding: 1.1rem;
            font-size: 0.95rem;
        }

        /* --- CONFIRMATION MODAL / MESSAGE --- */
        .confirmation-box {
            display: none;
            text-align: center;
            padding: 2rem;
            background: var(--bg-cream);
            border: 1px solid var(--gold-accent);
            margin-top: 2rem;
        }

        .confirmation-box h3 {
            font-size: 2rem;
            color: var(--text-dark);
            margin-bottom: 0.5rem;
        }

        .confirmation-box p {
            color: var(--text-muted);
            margin-bottom: 1rem;
        }

        /* --- FOOTER --- */
        footer {
            background-color: var(--text-dark);
            color: #CFC9C0;
